name: Deploy

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Validate deploy configuration
        env:
          DEPLOY_WEBHOOK_URL: ${{ secrets.DEPLOY_WEBHOOK_URL }}
          DEPLOY_WEBHOOK_SECRET: ${{ secrets.DEPLOY_WEBHOOK_SECRET }}
          DEPLOY_PROJECT: test-deploy-site
        run: |
          set -Eeuo pipefail

          if [ -z "${DEPLOY_WEBHOOK_URL:-}" ]; then
            echo "::error::DEPLOY_WEBHOOK_URL repository secret is missing or empty"
            exit 1
          fi

          if [ -z "${DEPLOY_WEBHOOK_SECRET:-}" ]; then
            echo "::error::DEPLOY_WEBHOOK_SECRET repository secret is missing or empty"
            exit 1
          fi

          case "$DEPLOY_WEBHOOK_URL" in
            http://*|https://*) ;;
            *)
              echo "::error::DEPLOY_WEBHOOK_URL must start with http:// or https://"
              exit 1
              ;;
          esac

          echo "DEPLOY_PROJECT=$DEPLOY_PROJECT"
          echo "DEPLOY_WEBHOOK_URL is configured"
          echo "DEPLOY_WEBHOOK_SECRET is configured"

      - name: Send deploy webhook
        env:
          DEPLOY_WEBHOOK_URL: ${{ secrets.DEPLOY_WEBHOOK_URL }}
          DEPLOY_WEBHOOK_SECRET: ${{ secrets.DEPLOY_WEBHOOK_SECRET }}
          DEPLOY_PROJECT: test-deploy-site
        run: |
          set -Eeuo pipefail

          BODY="$(jq -nc \
            --arg project "$DEPLOY_PROJECT" \
            --arg branch "${GITHUB_REF_NAME}" \
            --arg sha "${GITHUB_SHA}" \
            --arg source "github-actions" \
            '{project:$project, branch:$branch, sha:$sha, source:$source}')"

          TS="$(date +%s)"

          SIG_HEX="$(printf '%s.%s' "$TS" "$BODY" \
            | openssl dgst -sha256 -hmac "$DEPLOY_WEBHOOK_SECRET" -binary \
            | xxd -p -c 256)"

          curl -fsS -X POST "$DEPLOY_WEBHOOK_URL/deploy" \
            -H "Content-Type: application/json" \
            -H "X-Deploy-Timestamp: $TS" \
            -H "X-Deploy-Signature: sha256=$SIG_HEX" \
            --data "$BODY"
